# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID Chat Telegram kamu (dapat dicek via @userinfobot)
# Pisahkan koma jika ada lebih dari 1 admin (cth: 12345678,87654321)
ADMIN_CHAT_IDS=your_telegram_chat_id_here

# Secret token acak untuk memvalidasi request webhook Telegram
# Bebas diisi string acak minimal 16 karakter
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_key

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Ambil dari menu Project Settings > API di dashboard Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ==========================================
# CRON & SECURITY CONFIGURATION
# ==========================================
# Secret key untuk mengamankan endpoint cron dari pemanggilan sembarang
# Dipakai pada header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_random_cron_secret_password

# Batas latensi dianggap lemot (dalam milidetik, default 3000ms = 3 detik)
RESPONSE_TIME_THRESHOLD_MS=3000

# Jumlah percobaan gagal berturut-turut sebelum kirim alert DOWN (hindari false alarm)
RETRY_COUNT=2
